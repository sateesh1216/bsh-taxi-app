# Backend (already live)
EXPO_PUBLIC_API_URL=https://accountsdatabase.in
EXPO_PUBLIC_COMPANY_KEY=BSH

# Accounts + cloud data (Firebase). Leave empty to run as guest only.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# Google sign-in client IDs (needs a development build, see SETUP_ACCOUNTS.md)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
